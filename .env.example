MODELSCOPE_MODEL=Qwen-Ambassador/Qwen3.7-Plus

# Development Configuration

# Security Notes:
# - Never commit your actual .env file to version control
# - The ANON key is safe to expose in client-side code
# - Never use the SERVICE_ROLE key in client-side code
# - Keep all server-only keys outside VITE_ variables

# IntaSend server-only webhook signing secret. Payments stay locked until this verifies the callback.
INTASEND_WEBHOOK_SECRET=your_intasend_webhook_secret_here
APP_ORIGIN=http://localhost:8080
